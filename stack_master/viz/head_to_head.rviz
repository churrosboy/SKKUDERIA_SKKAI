Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /State1/Topic1
        - /Map Markers1
        - /Map Markers1/Sector Markers1
        - /Ego Robot1
        - /Perception1
        - /Perception1/Detection1
        - /Perception1/Detection1/Breakpoints1/Topic1
        - /Perception1/Tracking1
        - /Planner1
        - /Planner1/Considered OBS1
      Splitter Ratio: 0.5
    Tree Height: 668
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
