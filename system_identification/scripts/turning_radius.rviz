Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 40
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: TurningRadius
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /turning_radius/markers
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odom
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Shaft Length: 0.15
        Shaft Radius: 0.02
        Head Length: 0.07
        Head Radius: 0.04
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /odom
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 1.57
      Yaw: 0
      Name: Current View
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
