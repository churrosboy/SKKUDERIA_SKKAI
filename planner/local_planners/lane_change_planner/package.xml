<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lane_change_planner</name>
  <version>0.0.0</version>
  <description>Lane-change overtaking planner ported from unicorn-racing-stack (centerline +/- offset lanes, cosine-ramp evasion)</description>
  <maintainer email="hwany01@g.skku.edu">skkai</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>frenet_conversion</exec_depend>
  <exec_depend>f110_msgs</exec_depend>
  <depend>rclpy</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
